<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox spacing="30.0" styleClass="navbar" stylesheets="@navbar.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.thechallenge.NavbarController">
    <padding>
        <Insets bottom="10.0" left="30.0" right="30.0" top="10.0" />
    </padding>
    <children>
        <HBox styleClass="logo-section">
            <children>
                <Label styleClass="logo" text="W" />
                <Label styleClass="brand-name" text="WattWijk" />
            </children>
        </HBox>
        <HBox styleClass="navigation-section" HBox.hgrow="NEVER">
            <children>
                <Button fx:id="usageButton" mnemonicParsing="false" styleClass="nav-button" text="Verbruik" HBox.hgrow="ALWAYS" />
                <Button fx:id="neighborhoodButton" mnemonicParsing="false" styleClass="nav-button" text="Buurt" HBox.hgrow="ALWAYS" />
                <Button fx:id="notificationsButton" mnemonicParsing="false" styleClass="nav-button" text="Meldingen" HBox.hgrow="ALWAYS" />
                <Button fx:id="settingsButton" mnemonicParsing="false" styleClass="nav-button" text="Instellingen" HBox.hgrow="ALWAYS" />
            </children>
        </HBox>
        <HBox styleClass="user-section" HBox.hgrow="ALWAYS">
            <children>
                <Label styleClass="streak" text="Streak" />
                <Label styleClass="profile" text="Profile" />
            </children>
        </HBox>
    </children>
</HBox>
